FROM php:8.4-cli-trixie

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN apt-get update && apt-get install -y --no-install-recommends \
        libzip-dev \
    && docker-php-ext-install pdo_mysql zip bcmath \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN printf 'upload_max_filesize=6M\npost_max_size=8M\n' > /usr/local/etc/php/conf.d/uploads.ini

WORKDIR /app

COPY . .

RUN composer validate --no-check-publish \
    && composer install --no-interaction --prefer-dist \
    && composer check-platform-reqs

EXPOSE 8000

# Apenas para desenvolvimento local; produção usa FrankenPHP no Dockerfile principal.
CMD ["sh", "-c", "php artisan storage:link --force && exec php artisan serve --host=0.0.0.0 --port=8000"]
